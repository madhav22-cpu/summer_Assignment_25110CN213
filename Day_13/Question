#include <stdio.h>

int findMissing(int arr[], int size, int n) {
    int total = n * (n + 1) / 2;
    int sum = 0;

    for(int i = 0; i < size; i++) {
        sum += arr[i];
    }

    return total - sum;
}

int main() {
    int arr[] = {1, 2, 4, 5};
    int size = sizeof(arr) / sizeof(arr[0]);
    int n = 5;

    printf("Missing Number = %d\n", findMissing(arr, size, n));

    return 0;
}